# Third-party settings for local builds. Copy to .env.local (git-ignored) and fill in only what you use.
# Every one is optional: empty means that integration is off. See config/integrations.json,
# or run `node scripts/setup.mjs` to see what is on and how to turn the rest on.
# SYST and Prod values do not belong here: save them in GitHub Environments with
#   node scripts/setup.mjs set <KEY> --env Prod

# Sentry crash reporting (one project per app). Leave empty for everyday local work.
SENTRY_DSN_IOS=
SENTRY_DSN_ANDROID=
SENTRY_DSN_WEB_APP=
SENTRY_DSN_BACK_OFFICE=

# Grafana Cloud for the backend. Locally the Dev launch profile already sends data to the
# local stack (observability/docker-compose.yml), so these are only for testing a cloud connection.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
