<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: never back up or transfer app preferences. The session token is encrypted with an
  Android Keystore key that stays on this device, so a restored copy could not be read anyway.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
