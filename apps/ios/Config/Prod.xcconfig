// Prod environment: App Store builds.
APP_ENVIRONMENT = prod
APP_DISPLAY_NAME = Agentic
APP_BUNDLE_ID = com.agentic.app
API_BASE_URL = https:/$()/api.agentic.example
APS_ENVIRONMENT = production
// Crash reporting (Sentry). Empty means off. Set SENTRY_DSN_IOS in .env.local or the environment (config/integrations.json);
// `make generate` writes it into Secrets.xcconfig, which is never committed.
SENTRY_DSN =
#include? "Secrets.xcconfig"
