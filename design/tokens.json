{
  "$description": "Agentic Product Starter design tokens. Single source of truth for colours, type, spacing and radius across iOS, web app, back office and website. W3C Design Tokens format, importable into Figma with the Tokens Studio plugin.",
  "core": {
    "color": {
      "ink":    { "50": { "$type": "color", "$value": "#F7F8FA" }, "100": { "$type": "color", "$value": "#EEF0F4" }, "200": { "$type": "color", "$value": "#DDE1E8" }, "400": { "$type": "color", "$value": "#9AA3B2" }, "600": { "$type": "color", "$value": "#5B6475" }, "800": { "$type": "color", "$value": "#262B36" }, "900": { "$type": "color", "$value": "#14171F" }, "950": { "$type": "color", "$value": "#0C0E13" } },
      "indigo": { "300": { "$type": "color", "$value": "#9DB0FF" }, "400": { "$type": "color", "$value": "#7C93FF" }, "600": { "$type": "color", "$value": "#3F5BD9" }, "700": { "$type": "color", "$value": "#3249B8" } },
      "green":  { "400": { "$type": "color", "$value": "#4CC487" }, "600": { "$type": "color", "$value": "#1F8A4C" } },
      "amber":  { "400": { "$type": "color", "$value": "#F2B84B" }, "600": { "$type": "color", "$value": "#B86E00" } },
      "red":    { "400": { "$type": "color", "$value": "#F27474" }, "600": { "$type": "color", "$value": "#C93636" } },
      "white":  { "$type": "color", "$value": "#FFFFFF" }
    },
    "font": {
      "family": { "$type": "fontFamily", "$value": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" },
      "size": { "xs": { "$type": "dimension", "$value": "12px" }, "sm": { "$type": "dimension", "$value": "14px" }, "md": { "$type": "dimension", "$value": "16px" }, "lg": { "$type": "dimension", "$value": "20px" }, "xl": { "$type": "dimension", "$value": "28px" }, "xxl": { "$type": "dimension", "$value": "40px" } },
      "weight": { "regular": { "$type": "fontWeight", "$value": 400 }, "medium": { "$type": "fontWeight", "$value": 500 }, "bold": { "$type": "fontWeight", "$value": 700 } }
    },
    "space": { "xs": { "$type": "dimension", "$value": "4px" }, "s": { "$type": "dimension", "$value": "8px" }, "m": { "$type": "dimension", "$value": "16px" }, "l": { "$type": "dimension", "$value": "24px" }, "xl": { "$type": "dimension", "$value": "32px" }, "xxl": { "$type": "dimension", "$value": "48px" } },
    "radius": { "s": { "$type": "dimension", "$value": "8px" }, "m": { "$type": "dimension", "$value": "12px" }, "l": { "$type": "dimension", "$value": "20px" }, "pill": { "$type": "dimension", "$value": "999px" } }
  },
  "light": {
    "color": {
      "background":    { "$type": "color", "$value": "{core.color.white}" },
      "surface":       { "$type": "color", "$value": "{core.color.ink.50}" },
      "border":        { "$type": "color", "$value": "{core.color.ink.200}" },
      "textPrimary":   { "$type": "color", "$value": "{core.color.ink.900}" },
      "textSecondary": { "$type": "color", "$value": "{core.color.ink.600}" },
      "primary":       { "$type": "color", "$value": "{core.color.indigo.600}" },
      "primaryHover":  { "$type": "color", "$value": "{core.color.indigo.700}" },
      "onPrimary":     { "$type": "color", "$value": "{core.color.white}" },
      "success":       { "$type": "color", "$value": "{core.color.green.600}" },
      "warning":       { "$type": "color", "$value": "{core.color.amber.600}" },
      "error":         { "$type": "color", "$value": "{core.color.red.600}" }
    }
  },
  "dark": {
    "color": {
      "background":    { "$type": "color", "$value": "{core.color.ink.950}" },
      "surface":       { "$type": "color", "$value": "{core.color.ink.900}" },
      "border":        { "$type": "color", "$value": "{core.color.ink.800}" },
      "textPrimary":   { "$type": "color", "$value": "{core.color.ink.50}" },
      "textSecondary": { "$type": "color", "$value": "{core.color.ink.400}" },
      "primary":       { "$type": "color", "$value": "{core.color.indigo.400}" },
      "primaryHover":  { "$type": "color", "$value": "{core.color.indigo.300}" },
      "onPrimary":     { "$type": "color", "$value": "{core.color.ink.950}" },
      "success":       { "$type": "color", "$value": "{core.color.green.400}" },
      "warning":       { "$type": "color", "$value": "{core.color.amber.400}" },
      "error":         { "$type": "color", "$value": "{core.color.red.400}" }
    }
  }
}
